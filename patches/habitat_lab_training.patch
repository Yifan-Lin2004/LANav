+def _permute_tensor_first_dim_in_place(
+    tensor: torch.Tensor, ordering: torch.Tensor
+) -> None:
+    r"""Apply ``tensor[:] = tensor.index_select(0, ordering)`` in place.
+
+    VER reorders its retained experience after every rollout.  LANav's
+    500-step WSLA history makes the recurrent-state tensor large enough that a
+    second full-sized ``index_select`` result can exhaust an 80 GB GPU.  Cycle
+    decomposition keeps only one first-dimension slice as scratch storage.
+    """
+
+    if tensor.shape[0] <= 1:
+        return
+
+    permutation = ordering.detach().to(device="cpu", dtype=torch.int64).tolist()
+    visited = [False] * len(permutation)
+    for start in range(len(permutation)):
+        if visited[start]:
+            continue
+
+        visited[start] = True
+        next_index = permutation[start]
+        if next_index == start:
+            continue
+
+        scratch = tensor[start].clone()
+        current = start
+        while next_index != start:
+            tensor[current].copy_(tensor[next_index])
+            current = next_index
+            visited[current] = True
+            next_index = permutation[current]
+        tensor[current].copy_(scratch)
+
